  },
  "components": {
    "schemas": {
      "CreateInviteRequest": {
        "required": [
          "label",
          "expiresOn",
          "maxUses"
        ],
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "expiresOn": {
            "type": "string",
            "format": "date-time"
          },
          "maxUses": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "RedeemInviteRequest": {
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          }
        }
      },
      "RegisterRequest": {
        "required": [
          "email",
          "password",
          "inviteCode"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "inviteCode": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RenameRequest": {
        "required": [
          "displayName"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "JWT from POST /api/auth/login",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Identity.API"
    },
    {
      "name": "Invites"
    },
    {
      "name": "Users"
    }
  ]
}