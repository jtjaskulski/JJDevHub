{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher",
      "@tailwindcss/oxide",
      "lightningcss"
    ]
  },
  "scripts": {
    "prestart": "node scripts/copy-cv.mjs",
    "start": "vite --port 4200",
    "prebuild": "node scripts/copy-cv.mjs",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
