{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "@parcel/watcher"]
  },
  "scripts": {
    "prestart": "node scripts/copy-cv.mjs",
    "start": "vite --port 4200",
    "prebuild": "node scripts/copy-cv.mjs",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "pretest": "node scripts/copy-cv.mjs",
    "test": "vitest",
    "pretest:ci": "node scripts/copy-cv.mjs",
    "test:ci": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.6",
    "@jjdevhub/theme": "file:../shared/theme",
    "gsap": "^3.13.0",
    "lenis": "^1.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router": "^7.9.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^28.0.0",
    "sass": "^1.93.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.9",
    "vitest": "^4.0.8"
  }
}
