{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/identity/{**catch-all}"
        }
      },
      "connect": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/connect/{**catch-all}"
        }
      },
      "well-known": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/.well-known/{**catch-all}"
        }
      },
      "news": {
        "ClusterId": "news",
        "Match": {
          "Path": "/news/{**catch-all}"
        }
      },
      "learning": {
        "ClusterId": "learning",
        "Match": {
          "Path": "/learning/{**catch-all}"
        }
      },
      "cv": {
        "ClusterId": "cv",
        "Match": {
          "Path": "/cv/{**catch-all}"
        }
      },
      "contact": {
        "ClusterId": "contact",
        "Match": {
          "Path": "/contact/{**catch-all}"
        }
      },
      "graphql": {
        "ClusterId": "learning",
        "Match": {
          "Path": "/graphql/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "destination": {
            "Address": "http://identity"
          }
        }
      },
      "news": {
        "Destinations": {
          "destination": {
            "Address": "http://news"
          }
        }
      },
      "learning": {
        "Destinations": {
          "destination": {
            "Address": "http://learning"
          }
        }
      },
      "cv": {
        "Destinations": {
          "destination": {
            "Address": "http://cv"
          }
        }
      },
      "contact": {
        "Destinations": {
          "destination": {
            "Address": "http://contact"
          }
        }
      }
    }
  }
}
