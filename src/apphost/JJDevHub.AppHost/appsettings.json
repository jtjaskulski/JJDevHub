{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "Parameters": {
    "service-version": ""
  },
  "Gateway": {
    "Name": "gateway",
    "Image": "jjdevhub-gateway:dev",
    "Dockerfile": "deploy/docker/Dockerfile",
    "Project": "JJDevHub.Gateway",
    "Assembly": "JJDevHub.Gateway.dll",
    "Port": 8080,
    "Host": "127.0.0.1"
  },
  "Telemetry": {
    "Name": "otel-lgtm",
    "Image": "grafana/otel-lgtm",
    "Tag": "0.41.1",
    "GrpcPort": 4317,
    "HttpPort": 4318,
    "GrafanaPort": 3000,
    "Host": "127.0.0.1",
    "Mounts": [
      {
        "Source": "../deploy/grafana/dashboards.yaml",
        "Target": "/otel-lgtm/grafana/conf/provisioning/dashboards/custom.yaml"
      },
      {
        "Source": "../deploy/grafana/gateway-red.json",
        "Target": "/otel-lgtm/grafana/conf/provisioning/dashboards/custom/gateway-red.json"
      }
    ]
  }
}
